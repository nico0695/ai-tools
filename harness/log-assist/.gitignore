# Analyses never leave the machine: they hold customer logs and findings.
analyses/

# Drop zone for logs on their way into an analysis. Same reason: customer data.
inbox/

# Per-clone configuration written by loga-init.
loga.config.toml

# Skill copies generated by loga-init for native discovery.
.claude/skills/
.agents/skills/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# The parent repo ignores `*-temp*`, and git on macOS matches case-insensitively, so
# that rule swallows `08-TEMPLATES.md`. Keep the documentation regardless of where
# this repo lives.
!docs/scripts-idea/08-TEMPLATES.md
